#!/usr/bin/env bash
set -eo pipefail

PLUGIN_DIR="/var/lib/dokku/plugins/available/port-domains"
APP="$1"
COMMAND="$2"
PORT="$3"
DOMAIN="$4"
CONF_DIR="/home/dokku/$APP/nginx.conf.d"
CONF_FILE="$CONF_DIR/port-domains.conf"

ensure-app-exists() {
  if ! dokku apps:exists "$APP"; then
    echo "App $APP does not exist." >&2
    exit 1
  fi
}

write-config() {
  mkdir -p "$CONF_DIR"
  {
    for entry in $(ls "$PLUGIN_DIR/data/$APP/" 2>/dev/null || true); do
      echo "server {"
      echo "  listen $entry;"
      echo "  server_name $(cat "$PLUGIN_DIR/data/$APP/$entry");"
      echo "  location / {"
      echo "    proxy_pass http://$APP;"
      echo "    proxy_set_header Host \$host;"
      echo "    proxy_set_header X-Real-IP \$remote_addr;"
      echo "    proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;"
      echo "    proxy_set_header X-Forwarded-Proto \$scheme;"
      echo "  }"
      echo "}"
      echo
    done
  } >"$CONF_FILE"
}

case "$COMMAND" in
set)
  ensure-app-exists
  mkdir -p "$PLUGIN_DIR/data/$APP"
  echo "$DOMAIN" >"$PLUGIN_DIR/data/$APP/$PORT"
  write-config
  dokku nginx:build-config "$APP"
  dokku nginx:reload "$APP"
  echo "Mapped port $PORT to domain $DOMAIN for app $APP."
  ;;
list)
  ensure-app-exists
  if [ -d "$PLUGIN_DIR/data/$APP" ]; then
    for entry in $(ls "$PLUGIN_DIR/data/$APP"); do
      echo "Port $entry → Domain $(cat "$PLUGIN_DIR/data/$APP/$entry")"
    done
  else
    echo "No port mappings for $APP."
  fi
  ;;
unset)
  ensure-app-exists
  if [ -f "$PLUGIN_DIR/data/$APP/$PORT" ]; then
    rm "$PLUGIN_DIR/data/$APP/$PORT"
    write-config
    dokku nginx:build-config "$APP"
    dokku nginx:reload "$APP"
    echo "Removed mapping for port $PORT on app $APP."
  else
    echo "No mapping found for port $PORT."
  fi
  ;;
*)
  echo "Usage:"
  echo "  dokku port-domains:set <app> <port> <domain>"
  echo "  dokku port-domains:unset <app> <port>"
  echo "  dokku port-domains:list <app>"
  ;;
esac
