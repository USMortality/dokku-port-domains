#!/usr/bin/env bash
set -eo pipefail

PLUGIN_DIR="/var/lib/dokku/plugins/available/port-domains"

print_usage() {
  cat <<EOF
Usage:
  dokku port-domains:set <app> <port> <domain>
  dokku port-domains:unset <app> <port>
  dokku port-domains:list <app>
EOF
}

ensure_app_exists() {
  if ! dokku apps:exists "$APP"; then
    echo "App $APP does not exist." >&2
    exit 1
  fi
}

write_config() {
  mkdir -p "$CONF_DIR"
  for entry in $(ls "$PLUGIN_DIR/data/$APP/" 2>/dev/null || true); do
    cat <<EOF >>"$CONF_FILE"
server {
  listen $entry;
  server_name $(cat "$PLUGIN_DIR/data/$APP/$entry");
  location / {
    proxy_pass http://$APP;
    proxy_set_header Host \$host;
    proxy_set_header X-Real-IP \$remote_addr;
    proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto \$scheme;
  }
}

EOF
  done
}

setup_directories() {
  CONF_DIR="/home/dokku/$APP/nginx.conf.d"
  CONF_FILE="$CONF_DIR/port-domains.conf"
}

case "$1" in
port-domains:list)
  APP="$2"
  setup_directories
  ensure_app_exists
  if [ -d "$PLUGIN_DIR/data/$APP" ]; then
    for entry in $(ls "$PLUGIN_DIR/data/$APP"); do
      echo "Port $entry → Domain $(cat "$PLUGIN_DIR/data/$APP/$entry")"
    done
  else
    echo "No port mappings for $APP."
  fi
  ;;
port-domains:set)
  APP="$2"
  PORT="$3"
  DOMAIN="$4"
  setup_directories
  ensure_app_exists
  mkdir -p "$PLUGIN_DIR/data/$APP"
  echo "$DOMAIN" >"$PLUGIN_DIR/data/$APP/$PORT"
  write_config
  dokku nginx:build-config "$APP"
  dokku nginx:reload "$APP"
  echo "Mapped port $PORT to domain $DOMAIN for app $APP."
  ;;
port-domains:unset)
  APP="$2"
  PORT="$3"
  setup_directories
  ensure_app_exists
  if [ -f "$PLUGIN_DIR/data/$APP/$PORT" ]; then
    rm "$PLUGIN_DIR/data/$APP/$PORT"
    write_config
    dokku nginx:build-config "$APP"
    dokku nginx:reload "$APP"
    echo "Removed mapping for port $PORT on app $APP."
  else
    echo "No mapping found for port $PORT."
  fi
  ;;
*)
  exit $DOKKU_NOT_IMPLEMENTED_EXIT
  ;;
esac
